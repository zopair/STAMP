{
  "name": "stamp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api:dev": "wrangler dev --config wrangler.jsonc",
    "api:deploy": "wrangler deploy --config wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply stamp-production --local --config wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply stamp-production --remote --config wrangler.jsonc"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.40.0"
  }
}